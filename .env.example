# Copiá a .env local (no subir al repositorio) o configurá solo en Vercel → Settings → Environment Variables.
# Ver: README.md — sección del asistente Fernanda (chat).

DEEPSEEK_API_KEY=

# Opcional. Por defecto: deepseek-chat
# DEEPSEEK_MODEL=deepseek-chat

# Orígenes extra permitidos para POST /api/chat (ej. preview de Vercel), separados por coma.
# CHAT_ALLOWED_ORIGINS=https://tu-proyecto.vercel.app
